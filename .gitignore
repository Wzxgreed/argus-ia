# Argus-IA — Fichiers à ignorer

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/
ENV/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environnement & secrets
.env.local
.env.*.local
*.key
*.pem
secrets.json
credentials.json

# Data & logs (ne pas versionner les snapshots quotidiens)
data/2*.json
data/*_2*.json
data/validation_report.txt
data/history/
logs/
*.log

# Paper trading positions temporaires
Portefeuille/PAPER_POSITIONS.json

# Backups & drafts
*.bak
*_DRAFT_*.md

# Fichiers générés automatiquement (PDFs d'analyse)
*.pdf

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/
node_modules/
*.pid
