# Argus-IA — Configuration des sources de données
# Copier ce fichier en .env.local et remplir avec vos clés API

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Financial Modeling Prep (FMP) — Source secondaire institutionnelle
# Inscription : https://site.financialmodelingprep.com/
# Plan recommandé : Starter ($19/mois) ou Essential ($29/mois)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FMP_API_KEY=OafDZkMZ0IX8KhiDAG1sSDXPuL3LL0De

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Yahoo Finance — Source primaire (gratuit, pas de clé requise)
# yfinance utilise les endpoints publics de Yahoo Finance
# Pas de configuration nécessaire
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# YF_ENABLED=true  # toujours true par défaut

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Sources futures / optionnelles
# Décommenter et remplir si vous souhaitez ajouter ces sources
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Alpha Vantage — Données fondamentales et techniques
# Inscription : https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI — Fil d'actualités financières
# Inscription : https://newsapi.org/
# NEWS_API_KEY=your_newsapi_key_here

# Polygon.io — Données de marché temps réel (US)
# Inscription : https://polygon.io/
# POLYGON_API_KEY=your_polygon_key_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Paramètres système
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Fuseau horaire pour les timestamps
TZ=America/New_York

# Nombre de jours de rétention des snapshots historiques
HISTORY_RETENTION_DAYS=180

# Mode debug (true = logs détaillés, false = silencieux)
DEBUG=false
